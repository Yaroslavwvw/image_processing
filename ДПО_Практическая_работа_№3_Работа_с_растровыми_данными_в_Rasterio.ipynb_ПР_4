        "\n",
        "from rasterio.transform import from_origin\n",
        "\n",
        "# Открываем исходное изображение\n",
        "with rasterio.open(\"landsat.tif\") as src:\n",
        "    # Считываем нужные каналы (например, RGB)\n",
        "    red = src.read(3)\n",
        "    green = src.read(2)\n",
        "    blue = src.read(1)\n",
        "\n",
        "    # Получаем параметры исходного растра\n",
        "    transform = src.transform\n",
        "    profile = src.profile\n",
        "\n",
        "# --- Обрезаем часть изображения (например, центральную область) ---\n",
        "row_start, row_end = 200, 800\n",
        "col_start, col_end = 200, 800\n",
        "\n",
        "cropped_red = red[row_start:row_end, col_start:col_end]\n",
        "cropped_green = green[row_start:row_end, col_start:col_end]\n",
        "cropped_blue = blue[row_start:row_end, col_start:col_end]\n",
        "\n",
        "# --- Обновляем метаданные профиля для нового файла ---\n",
        "# Количество строк и столбцов меняется\n",
        "height = cropped_red.shape[0]\n",
        "width = cropped_red.shape[1]\n",
        "\n",
        "# Корректируем географическую привязку (смещаем верхний левый угол)\n",
        "new_transform = rasterio.transform.Affine(\n",
        "    transform.a,\n",
        "    transform.b,\n",
        "    transform.c + col_start * transform.a,\n",
        "    transform.d,\n",
        "    transform.e,\n",
        "    transform.f + row_start * transform.e\n",
        ")\n",
        "\n",
        "profile.update({\n",
        "    \"height\": height,\n",
        "    \"width\": width,\n",
