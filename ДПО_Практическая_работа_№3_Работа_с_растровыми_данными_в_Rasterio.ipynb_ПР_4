        "# --- Сохраняем в новый файл ---\n",
        "output_file = \"clipped_multispectral.tif\"\n",
        "with rasterio.open(output_file, \"w\", **profile) as dst:\n",
        "    dst.write(cropped_red, 1)\n",
        "    dst.write(cropped_green, 2)\n",
